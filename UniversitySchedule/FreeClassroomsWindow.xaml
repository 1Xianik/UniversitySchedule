<Window x:Class="UniversitySchedule.WPF.FreeClassroomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свободные аудитории" Height="550" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Поиск свободных аудиторий" 
                   Style="{StaticResource HeaderText}" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="День недели:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="2" x:Name="cmbDay" 
                  Style="{StaticResource RoundedComboBox}" Margin="0,0,0,15">
            <ComboBoxItem Content="Понедельник" Tag="1"/>
            <ComboBoxItem Content="Вторник" Tag="2"/>
            <ComboBoxItem Content="Среда" Tag="3"/>
            <ComboBoxItem Content="Четверг" Tag="4"/>
            <ComboBoxItem Content="Пятница" Tag="5"/>
            <ComboBoxItem Content="Суббота" Tag="6"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Номер пары:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4" x:Name="cmbPair" 
                  Style="{StaticResource RoundedComboBox}" Margin="0,0,0,15">
            <ComboBoxItem Content="1 пара (08:30 – 10:00)" Tag="1"/>
            <ComboBoxItem Content="2 пара (10:10 – 11:40)" Tag="2"/>
            <ComboBoxItem Content="3 пара (12:10 – 13:40)" Tag="3"/>
            <ComboBoxItem Content="4 пара (13:50 – 15:20)" Tag="4"/>
            <ComboBoxItem Content="5 пара (15:30 – 17:00)" Tag="5"/>
        </ComboBox>

        <Button Grid.Row="5" x:Name="btnSearch" Content="🔍 Найти" 
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Center" Width="160" 
                Margin="0,0,0,15" Click="BtnSearch_Click"/>

        <GroupBox Grid.Row="6" Header="Свободные аудитории" 
                  Style="{StaticResource StyledGroupBox}">
            <DataGrid x:Name="dgFreeRooms" Style="{StaticResource StyledDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Аудитория" Binding="{Binding RoomNumber}" Width="150"/>
                    <DataGridTextColumn Header="Корпус" Binding="{Binding Building}" Width="*"/>
                    <DataGridTextColumn Header="Вместимость" Binding="{Binding Capacity}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>