<Window x:Class="UniversitySchedule.WPF.ReplacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Внесение замены" Height="650" Width="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: заголовок -->
            <RowDefinition Height="*"/>
            <!-- 1: DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- 2: label препод -->
            <RowDefinition Height="Auto"/>
            <!-- 3: ComboBox препод -->
            <RowDefinition Height="Auto"/>
            <!-- 4: label ауд -->
            <RowDefinition Height="Auto"/>
            <!-- 5: ComboBox ауд -->
            <RowDefinition Height="Auto"/>
            <!-- 6: label дата -->
            <RowDefinition Height="Auto"/>
            <!-- 7: DatePicker -->
            <RowDefinition Height="Auto"/>
            <!-- 8: label причина -->
            <RowDefinition Height="Auto"/>
            <!-- 9: TextBox причина -->
            <RowDefinition Height="Auto"/>
            <!-- 10: кнопки -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите занятие, для которого нужна замена:" 
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="dgSchedule" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" FontSize="12" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="День" Binding="{Binding DayOfWeekName}" Width="110"/>
                <DataGridTextColumn Header="Пара" Binding="{Binding PairNumber}" Width="50"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="80"/>
                <DataGridTextColumn Header="Дисциплина" Binding="{Binding SubjectName}" Width="*"/>
                <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="180"/>
                <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomNumber}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Новый преподаватель:" Margin="0,15,0,5"/>
        <ComboBox Grid.Row="3" x:Name="cmbNewTeacher" DisplayMemberPath="FullName" 
                  SelectedValuePath="TeacherID" FontSize="13" Padding="5"/>

        <TextBlock Grid.Row="4" Text="Новая аудитория:" Margin="0,10,0,5"/>
        <ComboBox Grid.Row="5" x:Name="cmbNewClassroom" DisplayMemberPath="DisplayName" 
                  SelectedValuePath="ClassroomID" FontSize="13" Padding="5"/>

        <TextBlock Grid.Row="6" Text="Дата замены:" Margin="0,10,0,5"/>
        <DatePicker Grid.Row="7" x:Name="dpDate" FontSize="13"/>

        <TextBlock Grid.Row="8" Text="Причина:" Margin="0,10,0,5"/>
        <TextBox Grid.Row="9" x:Name="txtReason" FontSize="13" Padding="5" Height="50" 
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="130" Padding="8" 
                    Margin="0,0,10,0" Click="BtnSave_Click" Background="#4CAF50" Foreground="White"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="130" Padding="8" 
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>