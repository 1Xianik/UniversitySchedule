<Window x:Class="UniversitySchedule.WPF.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно администратора" Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" CornerRadius="8" Margin="0,0,0,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2C5F8D" Offset="0"/>
                    <GradientStop Color="#4A90D9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="20,15">
                <Button Content="Выйти" DockPanel.Dock="Right" 
                        Style="{StaticResource PrimaryButton}"
                        Background="White" Foreground="#2C5F8D"
                        Click="BtnLogout_Click"/>
                <TextBlock x:Name="txtGreeting" FontSize="20" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Кнопки действий -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="🔄 Обновить" Style="{StaticResource SecondaryButton}" 
                        Margin="0,0,10,0" Click="BtnRefresh_Click"/>
                <Button Content="➕ Внести замену" Style="{StaticResource PrimaryButton}" 
                        Margin="0,0,10,0" Click="BtnAddReplacement_Click"/>
                <Button Content="🔍 Свободные аудитории" Style="{StaticResource PrimaryButton}" 
                        Margin="0,0,10,0" Click="BtnFreeClassrooms_Click"
                        Background="#5BAE5B"/>
                <Button Content="📊 Отчёт о занятости" Style="{StaticResource PrimaryButton}" 
                        Click="BtnWorkloadReport_Click"
                        Background="#D99A4A"/>
                <Button Content="👥 Пользователи" Style="{StaticResource PrimaryButton}" 
        Margin="0,0,10,0" Click="BtnUsers_Click"
        Background="#7B68EE"/>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <GroupBox Grid.Row="2" Header="Все расписание" Style="{StaticResource StyledGroupBox}">
            <DataGrid x:Name="dgAllSchedule" Style="{StaticResource StyledDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="День" Binding="{Binding DayOfWeekName}" Width="110"/>
                    <DataGridTextColumn Header="Пара" Binding="{Binding PairNumber}" Width="50"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding PairTime}" Width="120"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="90"/>
                    <DataGridTextColumn Header="Дисциплина" Binding="{Binding SubjectName}" Width="*"/>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="180"/>
                    <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomNumber}" Width="90"/>
                    <DataGridTextColumn Header="Замена" Binding="{Binding ReplacementTeacherName}" Width="160"/>
                    <DataGridTextColumn Header="Причина" Binding="{Binding ReplacementReason}" Width="150"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReplacement}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ReplacementBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>

        <TextBlock Grid.Row="3" x:Name="txtStatus" Margin="5,10,0,0" 
                   Foreground="#555555" FontStyle="Italic"/>
    </Grid>
</Window>