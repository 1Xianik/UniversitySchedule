<Window x:Class="UniversitySchedule.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расписание занятий" Height="666" Width="1116"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с градиентом -->
        <Border Grid.Row="0" CornerRadius="8" Margin="0,0,0,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2C5F8D" Offset="0"/>
                    <GradientStop Color="#4A90D9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="20,15">
                <Button x:Name="btnLogin" Content="Войти" DockPanel.Dock="Right" 
                        Style="{StaticResource PrimaryButton}" 
                        Background="White" Foreground="#2C5F8D"
                        Click="BtnLogin_Click"/>
                <TextBlock Text="  Расписание занятий" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Выбор группы -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Группа:" VerticalAlignment="Center" 
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox x:Name="cmbGroups" Width="220" 
                          Style="{StaticResource RoundedComboBox}"
                          DisplayMemberPath="GroupName" SelectedValuePath="GroupID"/>
                <Button x:Name="btnShowSchedule" Content="Показать" 
                        Style="{StaticResource PrimaryButton}"
                        Margin="15,0,0,0" Click="BtnShowSchedule_Click"/>
            </StackPanel>
        </Border>

        <!-- Выбор дня -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="День недели:" VerticalAlignment="Center" 
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox x:Name="cmbDay" Width="220" 
                          Style="{StaticResource RoundedComboBox}"
                          SelectionChanged="CmbDay_SelectionChanged">
                    <ComboBoxItem Content="Вся неделя" Tag="0"/>
                    <ComboBoxItem Content="Понедельник" Tag="1"/>
                    <ComboBoxItem Content="Вторник" Tag="2"/>
                    <ComboBoxItem Content="Среда" Tag="3"/>
                    <ComboBoxItem Content="Четверг" Tag="4"/>
                    <ComboBoxItem Content="Пятница" Tag="5"/>
                    <ComboBoxItem Content="Суббота" Tag="6"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Основное расписание -->
        <GroupBox Grid.Row="3" Header="Основное расписание" 
                  Style="{StaticResource StyledGroupBox}">
            <DataGrid x:Name="dgMainSchedule" Style="{StaticResource StyledDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="День" Binding="{Binding DayOfWeekName}" Width="110"/>
                    <DataGridTextColumn Header="Пара" Binding="{Binding PairNumber}" Width="50"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding PairTime}" Width="120"/>
                    <DataGridTextColumn Header="Дисциплина" Binding="{Binding SubjectName}" Width="*"/>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="180"/>
                    <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomNumber}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Замены -->
        <GroupBox Grid.Row="4" Header="Замены" 
                  Style="{StaticResource StyledGroupBox}" MaxHeight="220">
            <DataGrid x:Name="dgReplacements" Style="{StaticResource StyledDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="День" Binding="{Binding DayOfWeekName}" Width="110"/>
                    <DataGridTextColumn Header="Пара" Binding="{Binding PairNumber}" Width="50"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding PairTime}" Width="120"/>
                    <DataGridTextColumn Header="Дисциплина" Binding="{Binding SubjectName}" Width="*"/>
                    <DataGridTextColumn Header="Был препод" Binding="{Binding TeacherName}" Width="150"/>
                    <DataGridTextColumn Header="Замена (препод)" Binding="{Binding ReplacementTeacherName}" Width="150"/>
                    <DataGridTextColumn Header="Замена (ауд.)" Binding="{Binding ReplacementClassroomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Причина" Binding="{Binding ReplacementReason}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <TextBlock Grid.Row="5" x:Name="txtStatus" Margin="5,10,0,0" 
                   Foreground="#555555" FontStyle="Italic"/>
    </Grid>
</Window>