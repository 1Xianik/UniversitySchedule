<Window x:Class="UniversitySchedule.WPF.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно преподавателя" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Margin="0,0,0,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2C5F8D" Offset="0"/>
                    <GradientStop Color="#4A90D9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="txtGreeting" FontSize="20" FontWeight="Bold" 
                       Foreground="White" Margin="20,15"/>
        </Border>

        <TextBlock Grid.Row="1" Text="Ваше расписание на сегодня:" 
                   FontSize="15" FontWeight="SemiBold" Margin="5,0,0,10"/>

        <GroupBox Grid.Row="2" Header="Занятия" Style="{StaticResource StyledGroupBox}">
            <DataGrid x:Name="dgTeacherSchedule" Style="{StaticResource StyledDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Пара" Binding="{Binding PairNumber}" Width="50"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding PairTime}" Width="120"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="100"/>
                    <DataGridTextColumn Header="Дисциплина" Binding="{Binding SubjectName}" Width="*"/>
                    <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Замена" Binding="{Binding ReplacementTeacherName}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>